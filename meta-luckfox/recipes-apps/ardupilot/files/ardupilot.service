[Unit]
Description=ArduPilot Plane for Luckfox RV1106
After=luckfox-usb-gadget.service systemd-networkd.service
Requires=luckfox-usb-gadget.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 50 ]; do [ -c /dev/ttyGS0 ] && [ -n "$(cat /sys/kernel/config/usb_gadget/g1/UDC 2>/dev/null)" ] && exit 0; sleep 0.2; i=$((i+1)); done; exit 1'
ExecStart=/usr/bin/arduplane --defaults /etc/ardupilot.parm --serial0 tcp:0.0.0.0:5760 --serial1 /dev/ttyGS0
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
