From: hspencer <hspencer@local>
Subject: [PATCH] rv1106: move kernel_addr_c and fdt_addr_r to avoid zImage/FDT overlap

Linux 6.12 uncompressed Image exceeds 8 MiB, causing the ARM zImage
decompressor at 0x00808000 to relocate past 0x00c00000 and overwrite the
FDT. Move kernel_addr_c to 0x01000000 (16 MiB) and fdt_addr_r to
0x02000000 (32 MiB).

Upstream-Status: Inappropriate [board memory layout]

---
diff --git a/include/configs/rv1106_common.h b/include/configs/rv1106_common.h
index f25ba22b3db..b14a9889caf 100644
--- a/include/configs/rv1106_common.h
+++ b/include/configs/rv1106_common.h
@@ -71,18 +71,18 @@
 #define ENV_MEM_LAYOUT_SETTINGS		CONFIG_ENV_MEM_LAYOUT_SETTINGS
 #else
 /*
- *   Image:  0 - 8M
- *  zImage:  8 - 12M
- *     fdt: 12 - 13M
- * ramdisk: 14 ...
+ *   Image:  0 - 16M
+ *  zImage: 16 - 32M
+ *     fdt: 32 - 33M
+ * ramdisk: 34 ...
  */
 #define ENV_MEM_LAYOUT_SETTINGS		\
 	"scriptaddr=0x00b00000\0"	\
-	"pxefile_addr_r=0x00c00000\0"	\
-	"fdt_addr_r=0x00c00000\0"	\
-	"kernel_addr_c=0x00808000\0"	\
+	"pxefile_addr_r=0x02100000\0"	\
+	"fdt_addr_r=0x02000000\0"	\
+	"kernel_addr_c=0x01000000\0"	\
 	"kernel_addr_r=0x00008000\0"	\
-	"ramdisk_addr_r=0x000e00000\0"
+	"ramdisk_addr_r=0x02200000\0"
 #endif
 
 #define CONFIG_EXTRA_ENV_SETTINGS	\
