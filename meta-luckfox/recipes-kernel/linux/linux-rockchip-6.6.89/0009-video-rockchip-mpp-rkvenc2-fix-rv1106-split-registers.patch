From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: meta-luckfox <dev@luckfox.local>
Date: Sun, 20 Sep 2026 10:30:00 +0000
Subject: [PATCH] video: rockchip: mpp: rkvenc2: fix VEPU540C split registers and last slice flag

Upstream-Status: Pending
---
diff --git a/drivers/video/rockchip/mpp/mpp_rkvenc2.c b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
index 2be7cb56f981..e3c8cd6fd61f 100644
--- a/drivers/video/rockchip/mpp/mpp_rkvenc2.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
@@ -1115,7 +1115,8 @@ static void rkvenc2_check_split_task(struct mpp_dev *mpp, struct rkvenc_task *ta
 	u32 reg_enc_pic		= 0;
 	u32 reg_slt_split	= 0;
 
-	if (hw->vepu_type == RKVENC_VEPU_510) {
+	if (hw->vepu_type == RKVENC_VEPU_510 ||
+	    hw->vepu_type == RKVENC_VEPU_540C) {
 		reg_enc_pic = RKVENC510_REG_ENC_PIC;
 		reg_slt_split = RKVENC510_REG_SLI_SPLIT;
 	} else {
@@ -1591,7 +1592,8 @@ static void rkvenc2_read_slice_len(struct mpp_dev *mpp, struct rkvenc_task *task
 {
 	struct rkvenc_dev *enc = to_rkvenc_dev(mpp);
 	struct rkvenc_hw_info *hw = enc->hw_info;
-	u32 sli_num = mpp_read_relaxed(mpp, RKVENC2_REG_SLICE_NUM_BASE) & 0x3f;
+	u32 reg_snum = mpp_read_relaxed(mpp, RKVENC2_REG_SLICE_NUM_BASE);
+	u32 sli_num = reg_snum & 0x3f;
 	u32 new_irq_status = mpp_read(mpp, hw->int_sta_base);
 	union rkvenc2_slice_len_info slice_info;
 	u32 task_id = task->mpp_task.task_id;
@@ -1602,11 +1604,14 @@ static void rkvenc2_read_slice_len(struct mpp_dev *mpp, struct rkvenc_task *task
 	/* Need update irq status and slice number when enc done ready with new status*/
 	if ((new_irq_status != *irq_status) && (new_irq_status & INT_STA_ENC_DONE_STA)) {
 		*irq_status |= new_irq_status;
-		sli_num = mpp_read_relaxed(mpp, RKVENC2_REG_SLICE_NUM_BASE) & 0x3f;
+		reg_snum = mpp_read_relaxed(mpp, RKVENC2_REG_SLICE_NUM_BASE);
+		sli_num = reg_snum & 0x3f;
 		mpp_write(mpp, hw->int_clr_base, new_irq_status);
 	}
 
 	last = *irq_status & INT_STA_ENC_DONE_STA;
+	if (hw->vepu_type == RKVENC_VEPU_540C)
+		last |= (reg_snum >> 23) & 1;
 
 	mpp_dbg_slice("task %d wr %3d len start %s\n", task_id,
 		      sli_num, last ? "last" : "");
