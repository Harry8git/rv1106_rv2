From: hspencer <hspencer@local>
Subject: [PATCH] of: reserved_mem: only call dma_contiguous_early_fixup() after init succeeds

Commit 46efab01648a moved dma_contiguous_early_fixup() before
fdt_reserved_mem_save_node() -> fdt_init_reserved_mem_node(). When a DT
reserved-memory node (e.g. linux,cma) is bypassed via cmdline cma= and
freed back to memblock, its stale dma_mmu_remap entry remains and overlaps
subsequent allocations (e.g. rknpu), triggering BUG_ON in vm_area_add_early()
inside dma_contiguous_remap().

Upstream-Status: Pending

---
diff --git a/drivers/of/of_reserved_mem.c b/drivers/of/of_reserved_mem.c
index 7b5d6562fe4a..29ef805abd58 100644
--- a/drivers/of/of_reserved_mem.c
+++ b/drivers/of/of_reserved_mem.c
@@ -130,10 +130,6 @@ static int __init __reserved_mem_reserve_reg(unsigned long node,
 		size = dt_mem_next_cell(dt_root_size_cells, &prop);
 
 		if (size && early_init_dt_reserve_memory(base, size, nomap) == 0) {
-			/* Architecture specific contiguous memory fixup. */
-			if (of_flat_dt_is_compatible(node, "shared-dma-pool") &&
-			    of_get_flat_dt_prop(node, "reusable", NULL))
-				dma_contiguous_early_fixup(base, size);
 			pr_debug("Reserved memory: reserved region for node '%s': base %pa, size %lu MiB\n",
 				uname, &base, (unsigned long)(size / SZ_1M));
 		} else {
@@ -422,10 +418,6 @@ static int __init __reserved_mem_alloc_size(unsigned long node, const char *unam
 		       uname, (unsigned long)(size / SZ_1M));
 		return -ENOMEM;
 	}
-	/* Architecture specific contiguous memory fixup. */
-	if (of_flat_dt_is_compatible(node, "shared-dma-pool") &&
-	    of_get_flat_dt_prop(node, "reusable", NULL))
-		dma_contiguous_early_fixup(base, size);
 	/* Save region in the reserved_mem array */
 	fdt_reserved_mem_save_node(node, uname, base, size);
 	return 0;
@@ -542,6 +534,10 @@ static void __init fdt_init_reserved_mem_node(struct reserved_mem *rmem)
 		bool reusable =
 			(of_get_flat_dt_prop(node, "reusable", NULL)) != NULL;
 
+		if (!nomap && reusable &&
+		    of_flat_dt_is_compatible(node, "shared-dma-pool"))
+			dma_contiguous_early_fixup(rmem->base, rmem->size);
+
 		pr_info("%pa..%pa (%lu KiB) %s %s %s\n",
 			&rmem->base, &end, (unsigned long)(rmem->size / SZ_1K),
 			nomap ? "nomap" : "map",
