[Unit]
Description=Luckfox VTX Video Streamer (Standby / GPIO Pushbutton Trigger)
After=luckfox-usb-gadget.service rockchip-rkaiq-server.service
Requires=luckfox-usb-gadget.service

[Service]
Type=simple
ExecStart=/usr/bin/vtx
Restart=always
RestartSec=1
CPUSchedulingPolicy=fifo
ExecStartPre=/bin/sleep 8

[Install]
WantedBy=multi-user.target
