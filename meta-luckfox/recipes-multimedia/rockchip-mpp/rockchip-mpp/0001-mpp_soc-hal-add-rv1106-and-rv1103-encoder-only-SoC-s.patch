+static MPP_RET setup_vepu540c_intra_refresh(H265eV540cRegSet *regs, H265eV540cHalContext *ctx, RK_U32 frame_idx)
+{
+    RK_U32 h = ctx->cfg->prep.height;
+    RK_U32 w = ctx->cfg->prep.width;
+    MppEncROICfg roi;
+    MppEncROIRegion region;
+
+    if (!ctx->cfg->rc.refresh_en)
+        return MPP_OK;
+
+    memset(&roi, 0, sizeof(roi));
+    memset(&region, 0, sizeof(region));
+
+    roi.number = 1;
+    roi.regions = &region;
+
+    RK_U32 blocks_per_frame = ctx->cfg->rc.refresh_num ? ctx->cfg->rc.refresh_num : 4;
+    RK_U32 box_w = blocks_per_frame * 32;
+    RK_U32 box_h = 32;
+    RK_U32 steps_x = (w + box_w - 1) / box_w;
+    RK_U32 steps_y = (h + box_h - 1) / box_h;
+    RK_U32 total_steps = steps_x * steps_y;
+    RK_U32 step_idx = total_steps ? (frame_idx % total_steps) : 0;
+
+    region.x = (step_idx % steps_x) * box_w;
+    region.y = (step_idx / steps_x) * box_h;
+    region.w = box_w;
+    region.h = box_h;
+    if (region.x + region.w > w)
+        region.w = w - region.x;
+    if (region.y + region.h > h)
+        region.h = h - region.y;
+
+    region.intra = 1;
+    region.quality = 0;
+    region.abs_qp_en = 0;
+    vepu540c_set_roi(&regs->reg_rc_roi.roi_cfg, &roi, w, h);
+    return MPP_OK;
+}
+
 MPP_RET hal_h265e_v540c_gen_regs(void *hal, HalEncTask *task)
 {
     H265eV540cHalContext *ctx = (H265eV540cHalContext *)hal;
@@ -1224,8 +1264,8 @@ MPP_RET hal_h265e_v540c_gen_regs(void *hal, HalEncTask *task)
 
     hal_h265e_enter();
     hal_dbg_setup(ctx->dbg_ctx, NULL);
-    pic_width_align8 = (syn->pp.pic_width + 7) & (~7);
-    pic_height_align8 = (syn->pp.pic_height + 7) & (~7);
+    pic_width_align8 = MPP_ALIGN(syn->pp.pic_width, 16);
+    pic_height_align8 = MPP_ALIGN(syn->pp.pic_height, 16);
     pic_wd32 = (syn->pp.pic_width +  31) / 32;
     pic_h32 = (syn->pp.pic_height + 31) / 32;
 
@@ -1280,11 +1320,9 @@ MPP_RET hal_h265e_v540c_gen_regs(void *hal, HalEncTask *task)
     reg_ctl->common.func_en.enc_done_tmvp_en   = 1;
 
     reg_base->common.enc_rsl.pic_wd8_m1    = pic_width_align8 / 8 - 1;
-    reg_base->common.src_fill.pic_wfill    = ((syn->pp.pic_width & 0x7) != 0)
-                                             ? (8 - (syn->pp.pic_width & 0x7)) : 0;
+    reg_base->common.src_fill.pic_wfill    = pic_width_align8 - syn->pp.pic_width;
     reg_base->common.enc_rsl.pic_hd8_m1    = pic_height_align8 / 8 - 1;
-    reg_base->common.src_fill.pic_hfill    = ((syn->pp.pic_height & 0x7) != 0)
-                                             ? (8 - (syn->pp.pic_height & 0x7)) : 0;
+    reg_base->common.src_fill.pic_hfill    = pic_height_align8 - syn->pp.pic_height;
 
     reg_base->common.enc_pic.enc_stnd      = 1; //H265
     reg_base->common.enc_pic.cur_frm_ref   = !syn->sp.non_reference_flag; //current frame will be refered
@@ -1334,6 +1372,10 @@ MPP_RET hal_h265e_v540c_gen_regs(void *hal, HalEncTask *task)
     if (ctx->roi_data)
         vepu540c_set_roi(&regs->reg_rc_roi.roi_cfg, ctx->roi_data,
                          ctx->cfg->prep.width, ctx->cfg->prep.height);
+    if (ctx->cfg->rc.refresh_en && !task->rc_task->frm.is_intra) {
+        EncFrmStatus *frm_status = &task->rc_task->frm;
+        setup_vepu540c_intra_refresh(regs, ctx, frm_status->seq_idx);
+    }
     /*paramet cfg*/
     vepu540c_h265_global_cfg_set(ctx, regs);
 
