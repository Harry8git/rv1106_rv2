From 37b3bd0569272c7b3806b8c718c05d92ac171605 Mon Sep 17 00:00:00 2001
From: OE <oe@local>
Date: Fri, 17 Jul 2026 23:23:46 +0000
Subject: [PATCH] cmake: drop -Werror and hardcoded -march/-mthumb, let OE tune
 flags apply

OE injects the correct -mcpu/-mfpu/-mfloat-abi/-mthumb flags via the
toolchain file. The hardcoded -march=armv7-a conflicts with
-mcpu=cortex-a7 (cc1plus warning on every TU), and -mthumb/-mthumb-interwork
duplicates what the OE tune already sets. -Werror is also dropped since
newer host GCC warnings would otherwise turn into hard build failures for
vendor code we do not control.

Upstream-Status: Inappropriate [OE cross-compile integration; the OE tune
flags already provide the correct -mcpu/-mfpu/-mfloat-abi/-mthumb, and
-Werror is dropped only because this vendor code isn't warning-clean under
newer host GCC versions we build with]
---
 rkaiq/cmake/CompileOptions.cmake | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/rkaiq/cmake/CompileOptions.cmake b/rkaiq/cmake/CompileOptions.cmake
index 47edbef..1e97ea9 100644
--- a/rkaiq/cmake/CompileOptions.cmake
+++ b/rkaiq/cmake/CompileOptions.cmake
@@ -1,10 +1,10 @@
-set(CMAKE_C_FLAGS                  "${CMAKE_C_FLAGS} -Wall -Wextra -Werror -fPIC")
+set(CMAKE_C_FLAGS                  "${CMAKE_C_FLAGS} -Wall -Wextra  -fPIC")
 set(CMAKE_C_FLAGS_DEBUG          "-O0 -g -gdwarf -fexceptions -funwind-tables")
 set(CMAKE_C_FLAGS_MINSIZEREL     "-Os -DNDEBUG")
 set(CMAKE_C_FLAGS_RELEASE        "-O4 -DNDEBUG")
 set(CMAKE_C_FLAGS_RELWITHDEBINFO "-O2 -g -gdwarf -fexceptions -funwind-tables")
 
-set(CMAKE_CXX_FLAGS                "${CMAKE_CXX_FLAGS} -Wall -Wextra -Werror -fPIC")
+set(CMAKE_CXX_FLAGS                "${CMAKE_CXX_FLAGS} -Wall -Wextra  -fPIC")
 set(CMAKE_CXX_FLAGS_DEBUG          "-O0 -g -gdwarf -fexceptions -funwind-tables")
 set(CMAKE_CXX_FLAGS_MINSIZEREL     "-Os -DNDEBUG")
 set(CMAKE_CXX_FLAGS_RELEASE        "-O4 -DNDEBUG")
@@ -19,7 +19,6 @@ set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 if (ARCH STREQUAL "arm")
     add_compile_options(
-        -march=armv7-a
         )
 endif()
 
@@ -32,8 +31,8 @@ endif()
 if (CMAKE_CXX_COMPILER_ID MATCHES "GNU")
     if (ARCH STREQUAL "arm")
         #if (${CMAKE_C_COMPILER_VERSION} VERSION_LESS "12.4.0")
-            set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mthumb -mthumb-interwork")
-            set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -mthumb -mthumb-interwork")
+            set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS}")
+            set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
         #endif()
     endif()
     set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -std=gnu11")
